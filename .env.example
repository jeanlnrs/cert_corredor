# Copia este archivo como `.env.local` y completa con los datos de
# Supabase → Project Settings → API. Sin estas variables la app funciona
# en modo invitado (progreso solo en el navegador).
#
# La llave "anon" es pública por diseño (la protege Row Level Security).
# NUNCA pongas aquí la llave "service_role".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon
